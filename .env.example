DATABASE_URL="postgresql://user:password@ep-example-12345.region.aws.neon.tech/neondb?sslmode=require"
JWT_SECRET="replace-with-a-long-random-string"
ADMIN_EMAIL="admin@insightsmafia.com"
ADMIN_PASSWORD="changeme123"
ADMIN_NAME="Neeraj"

# Optional — powers Google Search Console indexing requests and keyword ranking
# data in /admin/seo. Paste the full contents of a Google Cloud service account
# JSON key as one line. See /admin/seo for setup steps.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional — SMTP credentials for the lead confirmation email sent from
# /api/leads. Without these set, lead submissions still save normally; the
# email send is just skipped (with a console warning). Hostinger's standard
# outgoing mail server is smtp.hostinger.com, port 465 (SSL).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
